{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Next.js Dev Server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "Next.js Dev (webpack)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:local"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "Next.js Stripe Test Mode",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:local", "--", "-p", "3050"],
      "port": 3050,
      "autoPort": false
    }
  ]
}
