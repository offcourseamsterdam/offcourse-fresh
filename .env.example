NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

FAREHARBOR_API_APP=
FAREHARBOR_API_USER=
FAREHARBOR_API_BASE=https://fareharbor.com/api/v1

# ── Stripe live keys (production + default) ──────────────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Stripe test keys (local dev only) ────────────────────────────────────────
# Set STRIPE_MODE=test in .env.local to activate these instead of the live keys.
# Get test keys from: https://dashboard.stripe.com/test/apikeys
# Get the test webhook secret by running: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_MODE=live
NEXT_PUBLIC_STRIPE_MODE=live
STRIPE_SECRET_KEY_TEST=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_TEST=
STRIPE_WEBHOOK_SECRET_TEST=

ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# Google OAuth client — reused by Google Ads conversion tracking (lib/google-ads/auth.ts)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Outscraper — reviews scraping (Google Maps + TripAdvisor) for the admin Reviews page.
# Get the key from app.outscraper.cloud → Profile. The same key is used to verify
# incoming webhook signatures (HMAC-SHA256). Configure place_id + TripAdvisor URL in the admin panel.
OUTSCRAPER_API_KEY=

NEXT_PUBLIC_SITE_URL=https://offcourseamsterdam.com
REVALIDATION_SECRET=
# Bearer secret Vercel sends to every cron route (/api/cron/**, /api/fareharbor/sync).
# Vercel injects it automatically when set in the project env.
CRON_SECRET=
EXTRAS_TOKEN_SECRET=

# WordPress (WP SEO AI) — headless blog backend. Server-side only (read over REST).
# WORDPRESS_URL: origin of the WordPress install, e.g. https://cms.offcourseamsterdam.com
#   Must answer at {WORDPRESS_URL}/wp-json/ with 200 JSON. Leave blank to disable
#   the blog (pages render "no posts yet"; sitemap/build stay green).
# WP_POST_TYPE: the custom post-type slug chosen in WP SEO AI (REST base). Defaults to "blog".
WORDPRESS_URL=
WP_POST_TYPE=blog

# Local development ONLY — set to 'true' in .env.local to skip admin login.
# Never set this in any deployed environment (it is also gated on NODE_ENV=development).
ADMIN_DEV_BYPASS=

# Floating "Admin ⚡" button (bottom-right corner) that establishes a REAL
# Supabase admin session with one click — no login form. Unlike
# ADMIN_DEV_BYPASS above, this works on Vercel PREVIEW deployments too, not
# just localhost (see src/lib/auth/dev-bypass.ts). Both vars must be set for
# it to appear; leaving either blank disables it.
#   ADMIN_DEV_BYPASS_SECRET — any non-empty value; its presence is what turns
#     the feature on for this environment. Set locally in .env.local, and in
#     Vercel → Settings → Environment Variables scoped to Preview ONLY.
#   ADMIN_DEV_BYPASS_EMAIL — the email of a real user_profiles row with
#     role='admin' to sign in as.
# NEVER set either of these in Vercel's Production environment scope — do
# not do this via the Vercel dashboard/API without explicitly confirming
# with Beer first, and note that preview URLs are often publicly reachable
# unless Vercel Preview Deployment Protection is turned on.
ADMIN_DEV_BYPASS_SECRET=
ADMIN_DEV_BYPASS_EMAIL=

# Slack incoming webhook — for booking notifications
# Create at: https://api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=
# Bot token (chat:write scope) — routes CRITICAL alerts to Beer's DM instead of the
# shared channel. Without it, postSlackCritical falls back to SLACK_WEBHOOK_URL only.
SLACK_BOT_TOKEN=
# Target DM channel/user id for critical alerts. Has a hardcoded fallback if unset.
SLACK_ALERT_DM_CHANNEL=

# Resend — for confirmation emails to guests
# Create at: https://resend.com → API Keys
RESEND_API_KEY=
# Testing: set to "true" locally to skip sending real confirmation emails while
# doing manual click-through booking tests.
SUPPRESS_CONFIRMATION_EMAILS=

# Catering order email recipient
# Test: info@offcourseamsterdam.com — Production: cruise@pureboats.com
CATERING_EMAIL_RECIPIENT=

# Supabase Management API token — for running migrations + type regen via the
# Management API (see CLAUDE.md → "Running migrations"). Server/CLI use only.
# Create at: supabase.com → Account (top right) → Access Tokens → Generate new token
SUPABASE_MANAGEMENT_TOKEN=

# Google Ads — server-side conversion tracking (Offline Conversion Import).
# When a Stripe payment succeeds, the webhook reports the conversion to Google
# using the gclid captured on the ad click. See docs/features/google-ads-conversion-tracking.md.
# 1. Apply for a developer token: Google Ads → Tools → API Center → Basic access
# 2. Create an "Import" conversion action (category Purchase) → copy its numeric ID
# 3. Reuse GOOGLE_OAUTH_CLIENT_ID/SECRET above (enable Google Ads API in the same
#    Cloud project) OR set Ads-specific ones below; generate a refresh token with
#    the https://www.googleapis.com/auth/adwords scope.
# Google Ads tag — Consent Mode v2 + remarketing audiences (no GTM, no Analytics needed)
# Format: AW-XXXXXXXXXX — find it in Google Ads → Admin → Google tag → Tag ID
NEXT_PUBLIC_GOOGLE_ADS_TAG_ID=

# Microsoft Clarity — session recordings + heatmaps for offcourseamsterdam.com.
# Create the project yourself at clarity.microsoft.com (signed in with your own
# Microsoft account — this isn't something Claude can create on your behalf).
# Find the Project ID in the project URL: clarity.microsoft.com/projects/view/<id>/
NEXT_PUBLIC_CLARITY_PROJECT_ID=

GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=          # 10-digit account, no dashes
GOOGLE_ADS_LOGIN_CUSTOMER_ID=    # only if under a manager (MCC); else leave blank
GOOGLE_ADS_CONVERSION_ACTION_ID= # numeric ID of the Import conversion action
GOOGLE_ADS_REQUIRE_CONSENT=true  # gate send-to-Google on cookie consent (default true)
GOOGLE_ADS_API_VERSION=          # e.g. v18 — set to the CURRENT version (API Center); versions sunset ~yearly
